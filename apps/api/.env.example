# ==============================================================================
# CertificaFlow API - Variáveis de Ambiente (.env)
# ==============================================================================

PROJECT_NAME="CertificaFlow API"
ENVIRONMENT="development"
VERSION="3.0.0"

# ------------------------------------------------------------------------------
# Banco de Dados (Supabase PostgreSQL - Região sa-east-1 São Paulo)
# ------------------------------------------------------------------------------
# Para desenvolvimento local sem Supabase, você pode usar SQLite:
# DATABASE_URL="sqlite+aiosqlite:///./certificaflow.db"

# Para conexão com o Supabase via Pooler (Supavisor) - porta 6543 (Recomendado para Vercel Serverless):
# Substitua [PROJECT_REF] e [SUA_SENHA] pelos dados do seu painel Supabase:
# DATABASE_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Conexão direta com Supabase (para migrações com Alembic) - porta 5432:
# DIRECT_URL="postgresql+psycopg://postgres:[SUA_SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"

DATABASE_URL="sqlite+aiosqlite:///./certificaflow.db"

# ------------------------------------------------------------------------------
# Segurança e Criptografia (LGPD)
# ------------------------------------------------------------------------------
# Chave de 32 bytes para AES-256-GCM (cifragem de CPF e dados sensíveis)
ENCRYPTION_KEY="certificaflow-secret-key-32bytes!!"

# Segredo para Blind Index (HMAC-SHA256) de busca de CPF
HMAC_SECRET="certificaflow-hmac-secret-deterministic"

# Segredo para assinatura de tokens JWT
JWT_SECRET="certificaflow-jwt-secret-very-secure-key-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["*"]
